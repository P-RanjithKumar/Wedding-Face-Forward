{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "scope": [
        {
          "name": "aura-backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}