# AURA default settings
# Shipped in the installer and copied to %LOCALAPPDATA%\AURA\.env on first launch.
# Keep this file free of personal data: no folder IDs, no paths to credential files.
# Relative paths are resolved inside %LOCALAPPDATA%\AURA\.

# Paths
EVENT_ROOT=./EventRoot
DB_PATH=./data/wedding.db

# Processing
WORKER_COUNT=4
CLUSTER_THRESHOLD=0.6
MAX_IMAGE_SIZE=2048
THUMBNAIL_SIZE=300
PROCESS_BATCH_SIZE=20

# Watcher
SCAN_INTERVAL=30
SUPPORTED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.avif,.heic,.heif,.bmp,.tiff,.tif,.gif,.cr2,.nef,.arw,.dng,.orf,.rw2,.raf,.pef

# Modes
DRY_RUN=false
LOG_LEVEL=INFO
USE_HARDLINKS=true

# Google Drive
# Leave DRIVE_ROOT_FOLDER_ID empty: with DRIVE_USE_APP_FOLDER=true, AURA uploads
# into an "AURA" folder in the signed-in user's own Drive (created if missing).
# Set a folder ID only for a folder AURA itself created earlier: AURA uses
# Google's drive.file permission and cannot see folders made by hand in Drive.
DRIVE_ROOT_FOLDER_ID=
DRIVE_USE_APP_FOLDER=true
UPLOAD_TIMEOUT_CONNECT=10
UPLOAD_TIMEOUT_READ=30
UPLOAD_MAX_RETRIES=3
UPLOAD_RETRY_DELAY=2
UPLOAD_BATCH_SIZE=5
UPLOAD_QUEUE_ENABLED=true
UPLOAD_WORKERS=4
FOLDER_SYNC_INTERVAL=10
CLOUD_REFRESH_INTERVAL=90

# Face matching speed: auto | gpu | cpu
# auto = a one-time speed test picks the graphics card (DirectML: NVIDIA,
# AMD or Intel, no CUDA needed) or the processor, whichever is faster.
COMPUTE_DEVICE=auto
